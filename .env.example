# Worker-only credentials. Never commit .env.
EPIAS_USERNAME=your_email@example.com
EPIAS_PASSWORD=your_password

# Local defaults use SQLite. For hosted services, use the SAME PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# SUPABASE_DB_URL remains supported outside Compose for existing deployments.

# Optional: use an independently hosted FastAPI service.
# Leave unset for the integrated Streamlit deployment.
# API_BASE_URL=http://localhost:8000

# Optional model override; a matching .metadata.json file is required.
# MODEL_PATH=model.json
